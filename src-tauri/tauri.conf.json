{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mentaliis",
  "version": "0.1.0",
  "identifier": "app.mentaliis",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "beforeBuildCommand": "npm --prefix ../frontend run build"
  },
  "app": {
    "windows": [
      {
        "title": "Mentaliis",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": true,
        "theme": "Dark",
        "backgroundColor": "#070b14"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' http://127.0.0.1:8756 data: asset: http://asset.localhost; connect-src 'self' http://127.0.0.1:8756 ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "deb", "appimage"],
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "resources": [],
    "category": "Productivity",
    "shortDescription": "Un second cerveau spatial.",
    "longDescription": "Mentaliis centralise notes, projets et visions dans un environnement spatial : chaque dossier est une porte, chaque note un objet que l'on place librement."
  },
  "plugins": {}
}
