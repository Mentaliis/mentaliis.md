{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mentaliis",
  "version": "../package.json",
  "identifier": "app.mentaliis",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": {
      "cwd": "../frontend",
      "script": "npm run dev"
    },
    "beforeBuildCommand": {
      "cwd": "../frontend",
      "script": "npm run build"
    }
  },
  "app": {
    "windows": [
      {
        "title": "Mentaliis",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": true,
        "theme": "Dark",
        "backgroundColor": "#070b14"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' http://127.0.0.1:8756 data: asset: http://asset.localhost; connect-src 'self' http://127.0.0.1:8756 ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "../engine/dist/mentaliis-engine": "engine"
    },
    "category": "Productivity",
    "shortDescription": "Un second cerveau spatial.",
    "longDescription": "Mentaliis centralise notes, projets et visions dans un environnement spatial : chaque dossier est une porte, chaque note un objet que l'on place librement.",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "installer/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "languages": [
          "French"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "Mentaliis"
      }
    },
    "licenseFile": "installer/LICENCE.txt",
    "copyright": "© 2026 AJTVIRTUAL - AMILCAR JOAO",
    "publisher": "AJTVIRTUAL - AMILCAR JOAO",
    "homepage": "https://github.com/Mentaliis/mentaliis.md",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "installer/dmg-fond.png",
        "windowSize": {
          "width": 540,
          "height": 380
        },
        "appPosition": {
          "x": 150,
          "y": 205
        },
        "applicationFolderPosition": {
          "x": 390,
          "y": 205
        }
      },
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4QjgyOTZFRDBCMjJDOUMKUldTY0xMTFFiaW00bUZicWRxNjFOME1TVERkelJ4OGkxQlVaQ2FYSmlhakdScFkwY1VORHpLaGcK",
      "endpoints": [
        "https://github.com/Mentaliis/mentaliis.md/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
